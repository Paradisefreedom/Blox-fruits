local MyButton = LeftGroupBox:AddButton({
    Text = "White Screen",
    Func = function()
        local player = game.Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui")
        
        -- Check if a white screen GUI already exists
        local whiteScreen = playerGui:FindFirstChild("WhiteScreenGui")
        if not whiteScreen then
            -- Create a new ScreenGui if it doesn't exist
            whiteScreen = Instance.new("ScreenGui")
            whiteScreen.Name = "WhiteScreenGui"
            whiteScreen.ResetOnSpawn = false
            whiteScreen.Parent = playerGui

            -- Create a Frame that covers the entire screen
            local whiteFrame = Instance.new("Frame")
            whiteFrame.Size = UDim2.new(12, 10, 11, 10) -- Full screen
            whiteFrame.Position = UDim2.new(0, 0, 0, 0)
            whiteFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- White color
            whiteFrame.BorderSizePixel = 0
            whiteFrame.Name = "WhiteFrame"
            whiteFrame.Parent = whiteScreen
        end

        -- Toggle visibility
        whiteScreen.Enabled = not whiteScreen.Enabled
        if whiteScreen.Enabled then
            print("Screen whitened")
        else
            print("White screen turned off")
        end
    end,
    DoubleClick = false,
    Tooltip = "Makes your screen white",
    DisabledTooltip = "I am disabled!",
    Disabled = false,
    Visible = true,
    Risky = false
})


local MyButton = LeftGroupBox:AddButton({
