-- LOOP A: Movement Loop (Runs forever, only acts when enabled)
task.spawn(function()
    while true do
        task.wait() 
        
        if not autoFarmEnabled then continue end 
        
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then 
            task.wait(1) 
            continue 
        end
        
        local hrp = char.HumanoidRootPart
        local targetNPC = getClosestTarget()

        if targetNPC then
            hrp.Anchored = true
            local targetCFrame = targetNPC.HumanoidRootPart.CFrame * CFrame.new(0, hoverHeight, 0)
            
            if Options.FarmMethod.Value == "Hover" then
                local distance = (hrp.Position - targetCFrame.Position).Magnitude
                
                local timeToTake = math.max(0.1, distance / hoverSpeed) 
                
                local tweenInfo = TweenInfo.new(timeToTake, Enum.EasingStyle.Linear)
                local currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
                
                currentTween:Play()
                task.wait(timeToTake) 
                
            elseif Options.FarmMethod.Value == "Teleport" then
                hrp.CFrame = targetCFrame
                task.wait(tpDelay / 10) 
            end
        else
            hrp.Anchored = false
            task.wait(0.5)
        end
    end
end)

-- LOOP B: Auto-Equip & Fast Attack Loop 
task.spawn(function()
    while true do
        task.wait(0.1) 
        
        if not autoFarmEnabled then continue end 
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local combatTool = char:FindFirstChild("Combat")
            if not combatTool then
                local toolInBackpack = LocalPlayer.Backpack:FindFirstChild("Combat")
                if toolInBackpack then
                    char.Humanoid:EquipTool(toolInBackpack)
                    combatTool = toolInBackpack
                end
            end
            
            if combatTool then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end
        end
    end
end)

