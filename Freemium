-- HELPER FUNCTION: Find closest living Bandit
local function getClosestBandit()
    local closestBandit = nil
    local shortestDistance = math.huge
    local character = LocalPlayer.Character
    
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local root = character.HumanoidRootPart

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == "Bandit" and obj:IsA("Model") then
            local hum = obj:FindFirstChild("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            
            if hum and hrp and hum.Health > 0 then
                local distance = (hrp.Position - root.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestBandit = obj
                end
            end
        end
    end
    return closestBandit
end

-- MAIN AUTOFARM TOGGLE
local autoFarmEnabled = false
local currentTween = nil

LeftGroupBox:AddToggle("MyToggle", {
    Text = "AutoFarm",
    Tooltip = "Auto Farm Levels", 
    DisabledTooltip = "I am disabled!", 
    Default = false,
    Disabled = false, 
    Visible = true, 
    Risky = false, 

    Callback = function(Value)
        autoFarmEnabled = Value
        local character = LocalPlayer.Character
        
        -- Reset anchor and cancel tween when toggled off
        if not autoFarmEnabled then
            if character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.Anchored = false 
            end
            if currentTween then
                currentTween:Cancel()
            end
        end

        if autoFarmEnabled then
            
            -- LOOP 1: AUTO-EQUIP AND FAST ATTACK
            task.spawn(function()
                while autoFarmEnabled do
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") then
                        
                        -- 1. Check for "Combat" tool and equip if it isn't already
                        local combatTool = char:FindFirstChild("Combat")
                        if not combatTool then
                            local toolInBackpack = LocalPlayer.Backpack:FindFirstChild("Combat")
                            if toolInBackpack then
                                char.Humanoid:EquipTool(toolInBackpack)
                                combatTool = toolInBackpack
                            end
                        end
                        
                        -- 2. Spam attack insanely fast if equipped
                        if combatTool then
                            combatTool:Activate() -- Activates the tool programmatically
                        end
                    end
                    
                    -- 0.05 seconds = 20 swings per second, leaving room for UI clicks!
                    task.wait(0.05) 
                end
            end)

            -- LOOP 2: MOVEMENT & POSITIONING
            task.spawn(function()
                while autoFarmEnabled do
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then
                        task.wait(1)
                        continue
                    end
                    
                    local rootPart = char.HumanoidRootPart
                    local bandit = getClosestBandit()

                    if bandit then
                        local targetCFrame = bandit.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0)
                        
                        -- Anchor to stay perfectly afloat
                        rootPart.Anchored = true 

                        if Options.FarmMethod.Value == "Hover" then
                            local distance = (rootPart.Position - targetCFrame.Position).Magnitude
                            local timeToTake = distance / hoverSpeed
                            
                            local tweenInfo = TweenInfo.new(timeToTake, Enum.EasingStyle.Linear)
                            currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
                            
                            currentTween:Play()
                            currentTween.Completed:Wait() 
                        elseif Options.FarmMethod.Value == "Teleport" then
                            rootPart.CFrame = targetCFrame
                            task.wait(tpDelay / 10) 
                        end
                    else
                        task.wait(0.5)
                    end
                end
            end)
        end
    end,
})

